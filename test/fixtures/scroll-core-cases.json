  {
    "name": "viewport: 全 null",
    "fn": "viewport",
    "args": [
      null,
      null,
      null
    ],
    "expected": {
      "delta": 0,
      "targetScrollTop": 0,
      "shouldRestore": false
    }
  },
  {
    "name": "viewport: anchor null",
    "fn": "viewport",
    "args": [
      null,
      130,
      500
    ],
    "expected": {
      "delta": 130,
      "targetScrollTop": 630,
      "shouldRestore": true
    }
  },
  {
    "name": "viewport: 正常",
    "fn": "viewport",
    "args": [
      100,
      130,
      500
    ],
    "expected": {
      "delta": 30,
      "targetScrollTop": 530,
      "shouldRestore": true
    }
  },
  {
    "name": "viewport: 差 0.5 恰好 → restore",
    "fn": "viewport",
    "args": [
      100,
      100.5,
      500
    ],
    "expected": {
      "delta": 0.5,
      "targetScrollTop": 500.5,
      "shouldRestore": true
    }
  },
  {
    "name": "viewport: 差 0.4 → 不 restore",
    "fn": "viewport",
    "args": [
      100,
      100.4,
      500
    ],
    "expected": {
      "delta": 0.4000000000000057,
      "targetScrollTop": 500.4,
      "shouldRestore": false
    }
  },
  {
    "name": "viewport: 负偏移",
    "fn": "viewport",
    "args": [
      100,
      80,
      500
    ],
    "expected": {
      "delta": -20,
      "targetScrollTop": 480,
      "shouldRestore": true
    }
  },
  {
    "name": "viewport: scroll null",
    "fn": "viewport",
    "args": [
      100,
      130,
      null
    ],
    "expected": {
      "delta": 30,
      "targetScrollTop": 30,
      "shouldRestore": true
    }
  },
