    "args": [
      0,
      9,
      0,
      "append"
    ],
    "expected": "last"
  },
  {
    "name": "chooseTrim: anchor==last → 翻转",
    "fn": "chooseTrim",
    "args": [
      0,
      9,
      9,
      "append"
    ],
    "expected": "first"
  },
  {
    "name": "chooseTrim: 距离相等取 first",
    "fn": "chooseTrim",
    "args": [
      0,
      8,
      4,
      null
    ],
