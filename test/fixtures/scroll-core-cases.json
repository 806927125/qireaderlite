  {
    "name": "trimWindow: 超限裁两端",
    "fn": "trimWindow",
    "args": [
      [
        1,
        2,
        3,
        4,
        5
      ],
      3,
      3,
      "append"
    ],
    "expected": {
      "kept": [
        3,
        4,
        5
      ],
      "removed": [
        1,
        2
      ]
    }
  },
  {
    "name": "trimWindow: 不超限原样",
    "fn": "trimWindow",
    "args": [
      [
        1,
        2
      ],
      5,
      1,
      null
    ],
    "expected": {
      "kept": [
        1,
        2
      ],
      "removed": []
    }
  },
  {
    "name": "trimWindow: limit=0 全清",
    "fn": "trimWindow",
    "args": [
      [
        1,
        2,
        3
      ],
      0,
      2,
      null
    ],
    "expected": {
      "kept": [],
      "removed": [
        1,
        3,
        2
      ]
    }
  },
  {
    "name": "trimWindow: prepend 方向",
    "fn": "trimWindow",
    "args": [
      [
        1,
        2,
        3,
        4,
        5
      ],
      3,
      1,
      "prepend"
    ],
    "expected": {
      "kept": [
        1,
        2,
        3
      ],
      "removed": [
        5,
        4
      ]
    }
  },
  {
    "name": "trimWindow: anchor 保持",
    "fn": "trimWindow",
    "args": [
      [
        1,
        2,
        3,
        4,
        5
      ],
      3,
      2,
      "append"
    ],
    "expected": {
      "kept": [
        2,
        3,
        4
      ],
      "removed": [
        1,
        5
      ]
    }
  },
  {
    "name": "trimWindow: 单章",
    "fn": "trimWindow",
    "args": [
      [
