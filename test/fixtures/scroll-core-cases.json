[
  {
    "name": "chooseTrim: first=null → last",
    "fn": "chooseTrim",
    "args": [
      null,
      9,
      4,
      null
    ],
    "expected": "last"
  },
  {
    "name": "chooseTrim: last=null → last",
    "fn": "chooseTrim",
    "args": [
      0,
      null,
      4,
      null
    ],
    "expected": "first"
  },
  {
    "name": "chooseTrim: append → first",
    "fn": "chooseTrim",
    "args": [
      0,
      9,
      4,
      "append"
    ],
    "expected": "first"
  },
  {
    "name": "chooseTrim: prepend → last",
    "fn": "chooseTrim",
    "args": [
      0,
      9,
      4,
      "prepend"
    ],
    "expected": "last"
  },
  {
    "name": "chooseTrim: 未知 mode → 按距离",
    "fn": "chooseTrim",
    "args": [
      0,
      9,
      4,
      "weird"
    ],
    "expected": "last"
  },
  {
    "name": "chooseTrim: anchor==first → 翻转",
