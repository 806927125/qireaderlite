  },
  {
    "name": "chooseTrim: 距离相等(append)",
    "fn": "chooseTrim",
    "args": [
      0,
      8,
      4,
      "append"
    ],
    "expected": "first"
  },
  {
    "name": "chooseTrim: 靠近 last",
    "fn": "chooseTrim",
    "args": [
      0,
      8,
      7,
      null
    ],
    "expected": "first"
  },
  {
    "name": "chooseTrim: 负数坐标",
    "fn": "chooseTrim",
    "args": [
